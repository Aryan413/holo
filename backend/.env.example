# Copy to .env (same folder as this file) and edit. Never commit .env.

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./holox.db

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=60

# Teachers must enter this code to register. Leave empty to disable teacher signup.
TEACHER_SIGNUP_CODE=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# echo = offline dev mode, anthropic = real answers
LLM_PROVIDER=echo
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
