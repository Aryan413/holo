# Copy to .env (same folder as this file) and edit. Never commit .env.

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./holox.db

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=60

# Teachers must enter this code to register. Leave empty to disable teacher signup.
TEACHER_SIGNUP_CODE=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Folder with the course notes the tutor searches. Leave empty to use ai-engine/notes.
NOTES_DIR=

# ---------- Which AI answers the students' questions ----------
# echo              placeholder only, repeats the question (default, needs no setup)
# ollama            free model on your own computer, through Ollama
# lmstudio          free model on your own computer, through LM Studio (start its local server)
# anthropic         Claude over the internet (needs LLM_API_KEY, costs money per use)
# openai_compatible any other server with an OpenAI-style API (needs LLM_BASE_URL)
LLM_PROVIDER=echo

# Model name. Required for ollama / lmstudio / openai_compatible:
#   Ollama:    the name shown by `ollama list`
#   LM Studio: the model identifier shown in its Developer / local server tab
# For anthropic, leave empty to use the default.
LLM_MODEL=

# Only for anthropic or a paid OpenAI-style service. Local servers do not need it.
LLM_API_KEY=

# Only for openai_compatible. ollama and lmstudio already know their own addresses.
LLM_BASE_URL=

# Local models on a laptop can be slow. Seconds to wait for one answer.
LLM_TIMEOUT_SECONDS=120
